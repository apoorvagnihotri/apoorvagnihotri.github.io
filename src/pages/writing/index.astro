---
import { getCollection } from "astro:content";
import WritingList from "../../components/WritingList.astro";
import SimpleHeader from "../../components/site/SimpleHeader.astro";
import { withBase } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("writing"))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title="Writing — Apoorv Agnihotri"
  description="Writing by Apoorv Agnihotri: research notes, literature reviews, essays, and archived informal blog posts."
  maxWidth="56rem"
>
  <SimpleHeader
    ariaLabel="Writing navigation"
    homeHref={withBase("/")}
    secondaryHref={withBase("/#writing")}
    secondaryLabel="Homepage"
  />

  <main id="main-content">
    <p class="eyebrow">Archive</p>
    <h1>Writing</h1>
    <p class="introduction">
      Research notes, literature reviews, web-native explanations, essays,
      and informal posts preserved from my earlier website.
    </p>
    <WritingList entries={entries} />
  </main>
</BaseLayout>

<style>
  main {
    width: min(calc(100% - 2rem), var(--max-width));
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) 0 5rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.15rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 9vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .introduction {
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.15rem;
  }
</style>
