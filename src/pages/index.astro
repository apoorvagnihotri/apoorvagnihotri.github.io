---
import { getCollection } from "astro:content";
import AboutSection from "../components/home/AboutSection.astro";
import HeroSection from "../components/home/HeroSection.astro";
import NewsSection from "../components/home/news/NewsSection.astro";
import ResearchSection from "../components/home/ResearchSection.astro";
import WorkSection from "../components/home/WorkSection.astro";
import WritingSection from "../components/home/WritingSection.astro";
import HomeLayout from "../layouts/HomeLayout.astro";

const writingEntries = (await getCollection("writing"))
  .filter((entry) => import.meta.env.DEV || !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<HomeLayout
  title="Apoorv Agnihotri"
  description="The personal academic website of Apoorv Agnihotri: research, collaborations, selected work, writing, and news."
>
  <HeroSection />
  <ResearchSection />
  <AboutSection />
  <WorkSection />
  <WritingSection entries={writingEntries} />
  <NewsSection />
</HomeLayout>
