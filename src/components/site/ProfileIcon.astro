---
type IconName = "email" | "linkedin" | "github" | "scholar" | "x" | "cv";

type Props = {
  name: IconName;
};

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true">
  {
    name === "email" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === "linkedin" && (
      <>
        <path d="M6 10v8" />
        <path d="M6 6.5v.01" />
        <path d="M10.5 18v-8" />
        <path d="M10.5 13.5c0-2.2 1.4-3.7 3.6-3.7 2.5 0 3.9 1.6 3.9 4.6V18" />
      </>
    )
  }
  {
    name === "github" && (
      <>
        <path d="M15 22v-3.8c.04-1-.35-1.95-1.05-2.65 3.45-.38 7.05-1.7 7.05-7.65a6 6 0 0 0-1.6-4.15A5.6 5.6 0 0 0 19.25.6S18 0 15 2.2a14.2 14.2 0 0 0-7.5 0C4.5 0 3.25.6 3.25.6a5.6 5.6 0 0 0-.15 3.15A6 6 0 0 0 1.5 7.9c0 5.93 3.6 7.27 7.05 7.65a3.85 3.85 0 0 0-1.05 2.65V22" />
        <path d="M7.5 19.5c-2.8.85-2.8-1.4-4-1.8" />
      </>
    )
  }
  {
    name === "scholar" && (
      <>
        <path d="m3 9 9-5 9 5-9 5-9-5Z" />
        <path d="M7 12v4.2c3 2.4 7 2.4 10 0V12" />
        <path d="M21 9v6" />
      </>
    )
  }
  {
    name === "x" && (
      <>
        <path d="M5 4 19 20" />
        <path d="M19 4 5 20" />
      </>
    )
  }
  {
    name === "cv" && (
      <>
        <path d="M6 2h8l4 4v16H6z" />
        <path d="M14 2v5h5" />
        <path d="M9 12h6M9 16h6" />
      </>
    )
  }
</svg>

<style>
  svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
</style>
