---
import { withBase } from "../../config/site";
import ProfileLinks from "../site/ProfileLinks.astro";
import HomeSection from "./HomeSection.astro";
---

<HomeSection
  id="contact"
  number="06"
  title="Contact"
  introduction="Email, code, publications, and social profiles in one place."
>
  <ProfileLinks label="Contact section profiles" />

  <div id="cv" class="cv">
    <h3>Curriculum vitae</h3>
    <p>
      <a href={withBase("/files/apoorv-agnihotri-cv.pdf")}>
        View or download my CV (PDF, 2 pages)
      </a>
    </p>
  </div>
</HomeSection>

<style>
  .cv {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }

  .cv h3 {
    margin: 0 0 1rem;
    font-size: 1rem;
  }

  .cv p {
    margin: 0;
  }
</style>
