---
import EmptyState from "./EmptyState.astro";
import HomeSection from "./HomeSection.astro";
---

<HomeSection
  id="contact"
  number="06"
  title="Contact"
  introduction="Email, GitHub, academic profiles, and social links will go here."
>
  <EmptyState>Contact details have not been added yet.</EmptyState>

  <div id="cv" class="cv-placeholder">
    <h3>Curriculum vitae</h3>
    <p>The CV will be linked here when it is ready.</p>
  </div>
</HomeSection>

<style>
  .cv-placeholder {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }

  .cv-placeholder h3 {
    margin: 0 0 1rem;
    font-size: 1rem;
  }

  .cv-placeholder p {
    margin: 0;
  }
</style>
