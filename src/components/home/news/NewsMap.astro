---
import { resolveSiteHref, withBase } from "../../../config/site";
import { formatNewsDate, projectToEuropeMap, type MappedNewsItem } from "../../../lib/news";

type Props = {
  items: MappedNewsItem[];
};

const { items } = Astro.props;
---

<figure class="news-map" data-news-map aria-labelledby="news-map-caption">
  <div class="news-map-plot">
    <img
      src={withBase("/images/news/europe-blank-map.svg")}
      alt=""
      width="972"
      height="673"
      loading="lazy"
      decoding="async"
    />
    {
      items.map((item) => {
        const city = item.location?.split(",")[0] ?? item.title;
        const position = projectToEuropeMap(
          item.mapCoordinates.latitude,
          item.mapCoordinates.longitude,
        );
        const markerAttributes = {
          class: `news-map-marker news-map-marker--${item.mapCoordinates.labelPlacement ?? "above-right"}`,
          "data-news-map-marker": "",
          "data-start": item.startDate,
          "data-end": item.endDate ?? item.startDate,
          style: `--map-x: ${position.x.toFixed(2)}; --map-y: ${position.y.toFixed(2)};`,
          "aria-label": `${city}: ${item.title}, ${formatNewsDate(item.startDate, item.datePrecision)}`,
        };

        return item.href ? (
          <a href={resolveSiteHref(item.href)} {...markerAttributes}>
            <span>{city}</span>
          </a>
        ) : (
          <span {...markerAttributes}>
            <span>{city}</span>
          </span>
        );
      })
    }
  </div>
  <figcaption id="news-map-caption">
    <span>Upcoming locations</span>
    <a href="https://commons.wikimedia.org/wiki/File:Europe_blank_map.svg">Map</a>
  </figcaption>
</figure>

<style>
  .news-map {
    min-width: 0;
    margin: 0;
    padding-top: 0.75rem;
  }

  .news-map-plot {
    position: relative;
    overflow: hidden;
    aspect-ratio: 972 / 673;
    border: 1px solid var(--line);
    background: var(--background);
  }

  .news-map-plot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.3);
    mix-blend-mode: multiply;
    opacity: 0.52;
  }

  .news-map-marker {
    position: absolute;
    z-index: 1;
    top: calc(var(--map-y) * 1%);
    left: calc(var(--map-x) * 1%);
    width: 0.66rem;
    height: 0.66rem;
    color: var(--text);
    transform: translate(-50%, -50%);
  }

  .news-map-marker::before {
    position: absolute;
    inset: 0;
    background: currentColor;
    content: "";
    -webkit-mask: var(--icon-map-pin) center / contain no-repeat;
    mask: var(--icon-map-pin) center / contain no-repeat;
  }

  .news-map-marker > span {
    position: absolute;
    padding: 0.08rem 0.2rem;
    background: color-mix(in srgb, var(--background) 90%, transparent);
    font-size: 0.55rem;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
  }

  .news-map-marker--above-left > span {
    right: 0.5rem;
    bottom: 0.45rem;
  }

  .news-map-marker--above-right > span {
    bottom: 0.45rem;
    left: 0.5rem;
  }

  .news-map-marker--below-left > span {
    top: 0.45rem;
    right: 0.5rem;
  }

  .news-map-marker--below-right > span {
    top: 0.45rem;
    left: 0.5rem;
  }

  figcaption {
    display: flex;
    margin-top: 0.35rem;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.6rem;
    line-height: 1.3;
  }

  figcaption a {
    text-underline-offset: 0.12em;
  }

  @media (max-width: 48rem) {
    .news-map {
      width: min(100%, 15rem);
      padding-top: 0.2rem;
    }
  }
</style>
