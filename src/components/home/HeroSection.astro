---
import { siteConfig } from "../../config/site";
import ProfileLinks from "../site/ProfileLinks.astro";
---

<section class="introduction" id="top" aria-labelledby="intro-heading">
  <h1 id="intro-heading">{siteConfig.name}</h1>
  <p class="lede">
    male, 27, single.
  </p>
  <p>
    I am Apoorv, born in Jabalpur, India. I have always been facinated with computers and enjoy applying machine learning to real world problems. This website is a collection of my current research interests, past collaborations, ramblings and when and where you might be able to find me IRL.
  </p>
  <p class="summary">
    I recently completed a master&apos;s degree in Machine Learning at the
    University of Tübingen and am{" "}
    <strong class="phd-status">currently actively applying for PhD positions</strong>. I
    am broadly interested in using AI to enable scientific discovery,
    with a particular affinity for applications in healthcare.
  </p>
  <div class="profile-links-wrap">
    <ProfileLinks label="Primary contact and profiles" />
  </div>
</section>

<style>
  .introduction {
    display: block;
    padding: clamp(6rem, 13vw, 9rem) 0 clamp(3.5rem, 6vw, 4rem);
  }

  h1 {
    max-width: none;
    margin: 0.25rem 0 1.5rem;
    font-family: var(--font-name);
    font-size: clamp(2.75rem, 8vw, 7rem);
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .lede {
    max-width: 44rem;
    margin: 0;
    font-family: var(--font-accent);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 1.45;
  }

  .summary {
    max-width: 42rem;
    margin: 2rem 0 0;
    color: var(--muted);
  }

  .profile-links-wrap {
    width: min(100%, 42rem);
    margin-top: 1.75rem;
  }

  .phd-status {
    display: inline;
    padding: 0.08em 0.28em;
    background: var(--highlight-background);
    color: var(--highlight-text);
    font-weight: 750;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
