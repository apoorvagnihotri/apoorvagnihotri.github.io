---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { resolveSiteHref } from "../config/site";

type Props = {
  entries: CollectionEntry<"work">[];
  headingLevel?: 2 | 3;
};

const { entries, headingLevel = 2 } = Astro.props;
---

<ul class="work-grid">
  {
    entries.map((entry) => (
      <li>
        <article>
          {
            entry.data.hero && (
              <figure>
                <Image
                  src={entry.data.hero.src}
                  alt={entry.data.hero.alt}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 44rem) calc(100vw - 2rem), 32rem"
                  loading="lazy"
                  decoding="async"
                />
                {entry.data.hero.caption && (
                  <figcaption>{entry.data.hero.caption}</figcaption>
                )}
              </figure>
            )
          }
          <div class="work-meta">
            <span>{entry.data.venue}</span>
            <span class="year">{entry.data.year}</span>
          </div>
          {
            headingLevel === 2 ? (
              <h2 class="work-title">{entry.data.title}</h2>
            ) : (
              <h3 class="work-title">{entry.data.title}</h3>
            )
          }
          <p class="authors">{entry.data.authors}</p>
          <p class="description">{entry.data.description}</p>
          <ul class="work-links" aria-label={`Links for ${entry.data.title}`}>
            {entry.data.links.map((link) => (
              <li>
                <a
                  href={resolveSiteHref(link.href)}
                  aria-label={`${link.label}: ${entry.data.title}`}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <ul class="tags" aria-label={`Topics for ${entry.data.title}`}>
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .work-grid {
    display: grid;
    margin: 2.25rem 0 0;
    padding: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    list-style: none;
  }

  article {
    height: 100%;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  figure {
    margin: 0 0 1.25rem;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    background: white;
  }

  figcaption {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .work-meta {
    display: flex;
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    justify-content: space-between;
    gap: 1rem;
  }

  .work-title {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.05rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.08;
  }

  .authors,
  .description {
    margin: 0;
    color: var(--muted);
  }

  .authors {
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .description {
    margin-top: 0.9rem;
    line-height: 1.55;
  }

  .work-links,
  .tags {
    display: flex;
    margin: 1rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    list-style: none;
  }

  .work-links a {
    font-size: 0.88rem;
    font-weight: 650;
    text-underline-offset: 0.2em;
  }

  .tags {
    margin-top: 0.9rem;
    gap: 0.4rem;
  }

  .tags li {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .year {
    white-space: nowrap;
  }

  @media (max-width: 44rem) {
    .work-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
