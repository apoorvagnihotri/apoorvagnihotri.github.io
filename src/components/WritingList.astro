---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../config/site";

type Props = {
  entries: CollectionEntry<"writing">[];
};

const { entries } = Astro.props;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);
---

<ol class="writing-list">
  {
    entries.map((entry) => (
      <li>
        <article>
          <div class="writing-meta">
            <span>
              {
                entry.data.draft
                  ? `Draft · ${entry.data.label}`
                  : entry.data.label
              }
            </span>
            <time datetime={entry.data.publishedAt.toISOString()}>
              {formatDate(entry.data.publishedAt)}
            </time>
          </div>
          <h3>
            <a href={withBase(`/writing/${entry.id}/`)}>{entry.data.title}</a>
          </h3>
          <p>{entry.data.description}</p>
          <ul class="tags" aria-label={`Tags for ${entry.data.title}`}>
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .writing-list {
    margin: 2.25rem 0 0;
    padding: 0;
    border-bottom: 1px solid var(--line, #d9d9d2);
    list-style: none;
  }

  .writing-list > li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line, #d9d9d2);
  }

  .writing-meta {
    display: flex;
    margin-bottom: 0.35rem;
    color: var(--muted, #65655e);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    margin: 0 0 0.45rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
  }

  h3 a {
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line, #d9d9d2);
    text-underline-offset: 0.18em;
  }

  h3 a:hover {
    text-decoration-color: currentColor;
  }

  p {
    max-width: 42rem;
    margin: 0;
    color: var(--muted, #65655e);
  }

  .tags {
    display: flex;
    margin: 0.9rem 0 0;
    padding: 0;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .tags li {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line, #d9d9d2);
    border-radius: 999px;
    color: var(--muted, #65655e);
    font-size: 0.72rem;
  }

  @media (max-width: 34rem) {
    .writing-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
