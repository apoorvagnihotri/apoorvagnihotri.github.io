---
import SimpleHeader from "../components/site/SimpleHeader.astro";
import { withBase } from "../config/site";
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title: string;
  description: string;
  publishedAt: Date;
  label: string;
  archived?: boolean;
};

const { title, description, publishedAt, label, archived = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(publishedAt);
---

<BaseLayout
  title={`${title} — Apoorv Agnihotri`}
  description={description}
  maxWidth="48rem"
  bodyLineHeight="1.75"
  skipHref="#article"
  skipLabel="Skip to article"
  footerBackHref={withBase("/writing/")}
  footerBackLabel="← Back to all writing"
>
  <SimpleHeader
    ariaLabel="Article navigation"
    homeHref={withBase("/")}
    secondaryHref={withBase("/writing/")}
    secondaryLabel="All writing"
  />

  <main id="article">
    <article>
      <header class="article-header">
        <p class="article-label">{label}</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
        <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
      </header>

      {
        archived && (
          <aside>
            This post was migrated from my previous website and is preserved as
            originally written. It reflects my perspective at the time of publication.
          </aside>
        )
      }

      <div class="article-body">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  main {
    width: min(calc(100% - 2rem), var(--max-width));
    margin: 0 auto;
    padding: clamp(4rem, 10vw, 8rem) 0 5rem;
  }

  .article-header {
    margin-bottom: 3rem;
  }

  .article-label {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .description {
    max-width: 40rem;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  time {
    color: var(--muted);
    font-size: 0.85rem;
  }

  aside {
    margin: 0 0 3rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--text);
    background: #f0f0eb;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .article-body {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.18rem);
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.15;
  }

  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.5rem;
  }

  .article-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 2.5rem auto;
  }

  .article-body :global(code) {
    padding: 0.12em 0.3em;
    background: #ecece6;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
