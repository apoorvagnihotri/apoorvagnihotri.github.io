---
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { siteConfig, withBase } from "../config/site";

type Props = {
  title: string;
  description: string;
  publishedAt: Date;
  label: string;
  archived?: boolean;
};

const { title, description, publishedAt, label, archived = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
}).format(publishedAt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} — Apoorv Agnihotri</title>
  </head>
  <body>
    <a class="skip-link" href="#article">Skip to article</a>
    <header>
      <nav aria-label="Article navigation">
        <a class="site-name" href={withBase("/")}>Apoorv Agnihotri</a>
        <a href={withBase("/writing/")}>All writing</a>
      </nav>
    </header>

    <main id="article">
      <article>
        <header class="article-header">
          <p class="article-label">{label}</p>
          <h1>{title}</h1>
          <p class="description">{description}</p>
          <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
        </header>

        {
          archived && (
            <aside>
              This post was migrated from my previous website and is preserved as
              originally written. It reflects my perspective at the time of publication.
            </aside>
          )
        }

        <div class="article-body">
          <slot />
        </div>
      </article>
    </main>

    <SiteFooter
      backHref={withBase("/writing/")}
      backLabel="← Back to all writing"
    />
    <AnalyticsConsent
      measurementId={siteConfig.analytics.googleMeasurementId}
    />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  :root {
    --font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-display: Georgia, "Times New Roman", serif;
    --background: #fafaf8;
    --text: #1b1b19;
    --muted: #65655e;
    --line: #d9d9d2;
    color-scheme: light;
  }

  body {
    margin: 0;
    min-width: 20rem;
    min-height: 100vh;
    background: var(--background);
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.75;
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.25rem;
  }

  .skip-link {
    position: fixed;
    z-index: 10;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--text);
    color: var(--background);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  body > header {
    border-bottom: 1px solid var(--line);
  }

  nav,
  main,
  body > footer {
    width: min(calc(100% - 2rem), 48rem);
    margin: 0 auto;
  }

  nav {
    display: flex;
    padding: 0.9rem 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
  }

  nav a {
    text-decoration: none;
  }

  .site-name {
    font-weight: 650;
  }

  main {
    padding: clamp(4rem, 10vw, 8rem) 0 5rem;
  }

  .article-header {
    margin-bottom: 3rem;
  }

  .article-label {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.15;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    letter-spacing: -0.035em;
  }

  .description {
    max-width: 40rem;
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  time {
    color: var(--muted);
    font-size: 0.85rem;
  }

  aside {
    margin: 0 0 3rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--text);
    background: #f0f0eb;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .article-body {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.18rem);
  }

  .article-body p,
  .article-body ul,
  .article-body ol {
    margin: 0 0 1.5rem;
  }

  .article-body img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 2.5rem auto;
  }

  .article-body code {
    padding: 0.12em 0.3em;
    background: #ecece6;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.9em;
  }

  body > footer {
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }
</style>
